{
    "name": "phpsoftbox/mailer",
    "description": "SMTP mailer for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpsoftbox/cs-fixer": "^1.2.1",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "ext-openssl": "Required for SMTP encryption tls/ssl."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Mailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Mailer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
